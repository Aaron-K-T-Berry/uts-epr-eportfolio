# Gatsby's webpack config expects transitive deps at the project root.
# pnpm's default isolated layout breaks resolution for packages like
# gatsby-link, @gatsbyjs/reach-router, and svg-react-loader.
public-hoist-pattern[]=*gatsby*
public-hoist-pattern[]=@gatsbyjs/*
public-hoist-pattern[]=prop-types
public-hoist-pattern[]=mitt
public-hoist-pattern[]=shallow-compare
public-hoist-pattern[]=svg-react-loader
